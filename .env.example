# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o arquivo .env — ele contém credenciais (veja .gitignore).
# Usado pelo compose.yml (docker compose carrega o .env automaticamente).

# Banco de dados (Postgres / RDS)
DB_USER=postgres
DB_PWD=troque-por-uma-senha-segura
DB_HOST=seu-endpoint-rds.amazonaws.com
DB_PORT=5432
