# Copie este arquivo para .env (cp .env.example .env).
# NUNCA versione o .env — ele pode conter credenciais (veja .gitignore).
# Usado pelo compose.yml (docker compose carrega o .env automaticamente).
#
# O fluxo de worktrees do PO copia o .env do worktree principal para cada novo
# worktree automaticamente (scripts/criar-worktree.sh), então normalmente você
# não precisa criar este arquivo à mão dentro de um worktree.

# --- Padrão: banco local via docker compose (serviço "database") ---
# Sobe com: docker compose up -d --build   e conecta sem ajuste nenhum.
DB_USER=postgres
DB_PWD=postgres
DB_HOST=database
DB_PORT=5432

# --- Server rodando fora do container (node server / yarn dev no host) ---
# DB_HOST=localhost
# DB_PORT=5433

# --- Banco no RDS (aula de RDS / produção) ---
# DB_USER=postgres
# DB_PWD=troque-por-uma-senha-segura
# DB_HOST=seu-endpoint-rds.amazonaws.com
# DB_PORT=5432
